# ==============================================================================
# Toolbench Environment Configuration Template
# Copy this file to '.env' and populate with your credentials.
# Do NOT commit '.env' to version control.
# ==============================================================================

# Required for LLM Generation & Evaluation (google-genai SDK)
# Obtain a free-tier API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Required only for the GitHub MCP Server (Docker container) in F1.5
# Requires 'repo' scope if accessing private repositories or issues.
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
